# Device secrets — the serial number alone is the root credential seed. Keep all of
# this out of the repo. See CONTRIBUTING.md.
secrets/
*.key
*.pem
sysinfo*
serial*
eco_passwd*

# Firmware / flash dumps (copyright + embedded secrets)
dumps/
*.img
*.bin
*.ubi
*.squashfs

# Traffic captures (redact before adding any excerpt by hand)
captures/
*.pcap
*.pcapng
*.sslkeylog
*.mitm

# Raw logs (may contain identifiers)
*.log
logs/

# Scratch
scratch/
tmp/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# serial recon driver (drives the device; output has secrets)
eco_recon*

# SSH private keys (the matching .pub is safe to commit)
*_ed25519
*_rsa
!*_ed25519.pub
!*_rsa.pub
recon/

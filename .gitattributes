# Normalize line endings: store LF in the repo and check out LF everywhere,
# regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

# Text formats that should always be LF
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.msg   text eol=lf
*.conf  text eol=lf
*.svg   text eol=lf

# Binary assets (never touch line endings)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.bin       binary
*.img       binary
*.ubi       binary
*.squashfs  binary
